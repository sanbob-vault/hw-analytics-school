    {
      "id": "x2ErBqDIZaVH-XM_xPm-m",
      "type": "text",
      "x": -4238.384496201039,
      "y": 1343.4794799311767,
      "width": 754.9249877929688,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8k",
      "roundness": null,
      "seed": 2029002741,
      "version": 133,
      "versionNonce": 796456083,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794031919999,
      "created": 1793977815735,
      "link": null,
      "locked": false,
      "text": "Болезнь встречается у 0,5% населения. Тест выявляет болезнь у больного\nс вероятностью 98%. У здорового человека тест ошибочно показывает\nболезнь с вероятностью 2%. Случайно выбранному человеку сделали тест,\nрезультат положительный. Какова вероятность, что человек действительно\nболен?",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Болезнь встречается у 0,5% населения. Тест выявляет болезнь у больного с вероятностью 98%. У здорового человека тест ошибочно показывает болезнь с вероятностью 2%. Случайно выбранному человеку сделали тест, результат положительный. Какова вероятность, что человек действительно болен?",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
