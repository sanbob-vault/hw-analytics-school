    {
      "id": "1T1HdJ6lY2j-HgzO-ZVSX",
      "type": "text",
      "x": -4219.599532362952,
      "y": 4143.386774302751,
      "width": 754.0740288628468,
      "height": 70.69444020589188,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bQq",
      "roundness": null,
      "seed": 1871070747,
      "version": 322,
      "versionNonce": 620712309,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793981996429,
      "created": 1793981395604,
      "link": null,
      "locked": false,
      "text": "Наши случайные величины зависимы. Помимо проверки условия, мы могли\nпосмотреть на ковариацию - она равна 0, если условия независимы, а она не\nравна.",
      "fontSize": 18.85185072157117,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Наши случайные величины зависимы. Помимо проверки условия, мы могли посмотреть на ковариацию - она равна 0, если условия независимы, а она не равна.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "-lQ8xofIrQPyq4r2kvVDY",
      "type": "text",
      "x": -4031.3185434577827,
      "y": 4267.0007493432495,
      "width": 283.29998779296875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
